<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450' width='800' height='450'>
  <defs>
    <linearGradient id='bgCrypto' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#0b0e14'/>
      <stop offset='100%' stop-color='#1a1f2c'/>
    </linearGradient>
    <linearGradient id='accentBinance' x1='0%' y1='0%' x2='100%' y2='0%'>
      <stop offset='0%' stop-color='#f0b90b'/>
      <stop offset='100%' stop-color='#f3ba2f'/>
    </linearGradient>
    <linearGradient id='cardBgCrypto' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#181a20'/>
      <stop offset='100%' stop-color='#2b313a'/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width='800' height='450' rx='16' fill='url(#bgCrypto)'/>

  <!-- Header Bar -->
  <rect width='800' height='40' fill='#0b0e11' rx='16'/>
  <rect y='30' width='800' height='10' fill='#0b0e11'/>
  <circle cx='24' cy='20' r='6' fill='#ef4444'/>
  <circle cx='44' cy='20' r='6' fill='#f59e0b'/>
  <circle cx='64' cy='20' r='6' fill='#10b981'/>
  <text x='400' y='25' fill='#f0b90b' font-family='sans-serif' font-size='13' text-anchor='middle' font-weight='bold'>Binance API Trading Bot — Python Automated Execution</text>

  <!-- Top Metrics Bar -->
  <rect x='20' y='55' width='760' height='60' rx='10' fill='url(#cardBgCrypto)' stroke='#2b313a' stroke-width='1'/>
  <text x='40' y='80' fill='#848e9c' font-family='sans-serif' font-size='11'>BTC/USDT Real-time</text>
  <text x='40' y='102' fill='#0ecb81' font-family='sans-serif' font-size='18' font-weight='bold'>$64,850.20 <tspan font-size='12' fill='#0ecb81'>+4.82%</tspan></text>

  <text x='240' y='80' fill='#848e9c' font-family='sans-serif' font-size='11'>24h Volume</text>
  <text x='240' y='102' fill='#eaecef' font-family='sans-serif' font-size='16' font-weight='bold'>$1.24B</text>

  <text x='420' y='80' fill='#848e9c' font-family='sans-serif' font-size='11'>Bot Strategy Status</text>
  <rect x='420' y='88' width='110' height='20' rx='4' fill='rgba(14, 203, 129, 0.15)'/>
  <text x='432' y='102' fill='#0ecb81' font-family='sans-serif' font-size='11' font-weight='bold'>● LIVE TRADING</text>

  <rect x='640' y='68' width='120' height='32' rx='6' fill='url(#accentBinance)'/>
  <text x='700' y='89' fill='#1e2329' font-family='sans-serif' font-size='12' text-anchor='middle' font-weight='bold'>API Connected</text>

  <!-- Candlestick Chart Window -->
  <rect x='20' y='130' width='520' height='295' rx='10' fill='url(#cardBgCrypto)' stroke='#2b313a' stroke-width='1'/>
  <text x='35' y='155' fill='#eaecef' font-family='sans-serif' font-size='13' font-weight='bold'>RSI + Moving Average Signal Chart</text>

  <!-- Grid lines -->
  <line x1='35' y1='180' x2='520' y2='180' stroke='#2b313a' stroke-dasharray='4,4'/>
  <line x1='35' y1='230' x2='520' y2='230' stroke='#2b313a' stroke-dasharray='4,4'/>
  <line x1='35' y1='280' x2='520' y2='280' stroke='#2b313a' stroke-dasharray='4,4'/>

  <!-- Candlesticks -->
  <rect x='70' y='210' width='14' height='60' fill='#0ecb81'/>
  <line x1='77' y1='190' x2='77' y2='280' stroke='#0ecb81' stroke-width='2'/>

  <rect x='110' y='240' width='14' height='40' fill='#f6465d'/>
  <line x1='117' y1='220' x2='117' y2='300' stroke='#f6465d' stroke-width='2'/>

  <rect x='150' y='200' width='14' height='70' fill='#0ecb81'/>
  <line x1='157' y1='180' x2='157' y2='290' stroke='#0ecb81' stroke-width='2'/>

  <rect x='190' y='190' width='14' height='50' fill='#0ecb81'/>
  <line x1='197' y1='170' x2='197' y2='250' stroke='#0ecb81' stroke-width='2'/>

  <!-- Trade Signal Marker -->
  <circle cx='197' cy='160' r='14' fill='#0ecb81'/>
  <text x='197' y='164' fill='#ffffff' font-family='sans-serif' font-size='9' text-anchor='middle' font-weight='bold'>BUY</text>

  <!-- Moving Average Line -->
  <path d='M40,290 Q120,240 200,210 T350,180 T500,160' fill='none' stroke='#f0b90b' stroke-width='2.5'/>

  <!-- Bot Orders Log Side Panel -->
  <rect x='555' y='130' width='225' height='295' rx='10' fill='url(#cardBgCrypto)' stroke='#2b313a' stroke-width='1'/>
  <text x='570' y='155' fill='#eaecef' font-family='sans-serif' font-size='13' font-weight='bold'>Automated Order Log</text>

  <rect x='570' y='170' width='195' height='45' rx='6' fill='#0b0e11'/>
  <text x='580' y='188' fill='#0ecb81' font-family='sans-serif' font-size='11' font-weight='bold'>LIMIT BUY BTC</text>
  <text x='580' y='205' fill='#848e9c' font-family='sans-serif' font-size='10'>Price: $64,200 | Stop-Loss Set</text>

  <rect x='570' y='225' width='195' height='45' rx='6' fill='#0b0e11'/>
  <text x='580' y='243' fill='#f0b90b' font-family='sans-serif' font-size='11' font-weight='bold'>TAKE PROFIT TRIGGERED</text>
  <text x='580' y='260' fill='#848e9c' font-family='sans-serif' font-size='10'>Profit: +3.4% | Executed</text>

  <!-- Risk Management Bar -->
  <rect x='570' y='280' width='195' height='130' rx='6' fill='rgba(240, 185, 11, 0.1)' stroke='#f0b90b' stroke-width='1'/>
  <text x='580' y='305' fill='#f0b90b' font-family='sans-serif' font-size='11' font-weight='bold'>⚡ Risk Management:</text>
  <text x='580' y='330' fill='#eaecef' font-family='sans-serif' font-size='10'>Stop-Loss: 1.5% | Pos Sizing: Active</text>
  <text x='580' y='355' fill='#848e9c' font-family='sans-serif' font-size='10'>Binance WebSocket Feed: Active</text>
  <text x='580' y='380' fill='#0ecb81' font-family='sans-serif' font-size='10' font-weight='bold'>High-Accuracy Signal Engine</text>
</svg>
